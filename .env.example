# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Redis
REDIS_URL=redis://localhost:6379

# Claude Code
CLAUDE_WORK_DIR=/home/deploy/claude-workspace
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=25

# Sessions
SESSION_TTL_MINUTES=60

# Concurrency
MAX_CONCURRENT_CLAUDE=5

# Approval System (approvals go to the active thread/DM automatically)
# APPROVAL_FALLBACK_CHANNEL_ID=optional-fallback-channel-id
APPROVAL_SERVER_PORT=7842
APPROVAL_TIMEOUT_MS=300000

# Logging
LOG_LEVEL=info
