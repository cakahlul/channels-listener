# Agent provider: claude or codex
PROVIDER=claude

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Google Chat (optional — set GOOGLE_CHAT_ENABLED=true to enable)
GOOGLE_CHAT_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_CHAT_WEBHOOK_PORT=7843
# GOOGLE_CHAT_VERIFICATION_TOKEN=optional-legacy-token

# Claude Code (used only with PROVIDER=claude)
CLAUDE_WORK_DIR=.
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=25
# CLAUDE_CODE_PATH=/path/to/claude

# Codex App Server (used only with PROVIDER=codex)
# Omitted model, reasoning, approval, and sandbox values use normal Codex configuration.
# CODEX_PATH=/path/to/codex
# CODEX_MODEL=gpt-5.6-luna
# CODEX_REASONING_EFFORT=max
# CODEX_WORK_DIR=/path/to/workspace
# CODEX_APPROVAL_POLICY=on-request
# CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=600000

# Sessions and schedules
DB_PATH=channels-listener.sqlite
SESSION_TTL_MINUTES=60
SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_TICK_MS=60000
SCHEDULER_SHELL_TIMEOUT_MS=600000

# Concurrency (applies to either provider)
MAX_CONCURRENT_CLAUDE=5

# Approval server
# APPROVAL_FALLBACK_CHANNEL_ID=optional-fallback-channel-id
APPROVAL_SERVER_PORT=7842
APPROVAL_TIMEOUT_MS=300000
# Hook-only overrides:
# APPROVAL_SERVER_URL=http://127.0.0.1:7842/approval
# APPROVAL_HOOK_LOG=/tmp/approval-hook.log

# POST /confirm DM Yes/No timeout
CONFIRM_TIMEOUT_MS=300000

# Logging
LOG_LEVEL=info
