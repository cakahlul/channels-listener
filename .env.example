# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Google Chat (optional — set GOOGLE_CHAT_ENABLED=true to enable)
GOOGLE_CHAT_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_CHAT_WEBHOOK_PORT=7843
# GOOGLE_CHAT_VERIFICATION_TOKEN=optional-legacy-token

# Claude Code
CLAUDE_WORK_DIR=/home/deploy/claude-workspace
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=25

# Sessions
SESSION_TTL_MINUTES=60

# Concurrency
MAX_CONCURRENT_CLAUDE=5

# Approval System (approvals go to the active thread/DM automatically)
# APPROVAL_FALLBACK_CHANNEL_ID=optional-fallback-channel-id
APPROVAL_SERVER_PORT=7842
APPROVAL_TIMEOUT_MS=300000

# Confirmation (POST /confirm from external bots) — DM Yes/No timeout
CONFIRM_TIMEOUT_MS=300000

# Scheduler shell-mode max wall-clock per run (10 min default — Playwright runs can take a few minutes)
SCHEDULER_SHELL_TIMEOUT_MS=600000

# Logging
LOG_LEVEL=info
# Agent provider: omitted/unknown/claude keeps Claude Agent SDK; codex uses local Codex App Server.
PROVIDER=claude
CODEX_PATH=/home/deploy/.local/bin/codex
CODEX_MODEL=gpt-5
CODEX_WORK_DIR=/home/deploy/codex-workspace
# Optional: otherwise Codex uses its configured approval/sandbox policy.
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=600000
